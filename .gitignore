# Built application files (대용량 빌드 결과물 제외)
*.apk
*.ap_
*.aab
*.dex
*.class

# Gradle build cache & directories
.gradle/
build/
**/build/

# Android Studio / IntelliJ IDEA files
.idea/
*.iml
*.iws
*.ipr
.navigation/
captures/
.externalNativeBuild/
.cxx/

# Local configuration file (SDK 경로 등 로컬 머신 설정)
local.properties

# Log files & dumps
*.log
*.hprof

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Large binaries & archives (AAR, ZIP, TAR 등)
*.aar
*.zip
*.tar.gz
*.7z

# Gradle Wrapper JAR는 예외 처리 (팀원 빌드를 위해 보존 필수)
!gradle/wrapper/gradle-wrapper.jar

# Keystore / signing files (보안 키 파일 제외)
*.jks
*.keystore
*.p12
*.key


# Secrets (Gemini API key etc.) - never commit
.env
**/.env
.env.*
!**/.env.example

# Node (server/rendy-intent-proxy has no dependencies, but never commit installs)
node_modules/

# VS Code 개인 설정
.vscode/

# 개발 중 만든 측정·조사 자료(에뮬레이터 로그, 스크린샷, 다운로드한 매뉴얼 그림 등).
# 이미 추적 중인 reports/ 파일은 이 규칙과 관계없이 계속 추적되며, 새 파일만 제외됩니다.
/reports/

# 로컬 작업용 DB·QA 사본 (앱은 app/src/main/assets/의 JSON만 읽음)
/hyundai_buttons_db_final.json
/rendy_qa_test_cases_final.json
