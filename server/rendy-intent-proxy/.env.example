# RENDY intent proxy configuration. Copy to .env and fill in. Never commit .env.

# Required. Google AI Studio API key (https://aistudio.google.com/apikey). Server-side only.
GEMINI_API_KEY=

# Model used for classification. Must be a stable model returned by `node server.mjs --check-models`.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional shared secret. When set, clients must send "Authorization: Bearer <token>".
# The Android app sends the value of rendy.llm.proxyToken (local.properties).
RENDY_PROXY_TOKEN=

# Network binding. 127.0.0.1 is reachable from the Android emulator as 10.0.2.2.
HOST=127.0.0.1
PORT=8787

# Upstream timeout and abuse limits.
UPSTREAM_TIMEOUT_MS=5000
RATE_LIMIT_PER_MINUTE=60
DAILY_REQUEST_LIMIT=3000
