<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Automotive Dark Theme -->
    <style name="Theme.RentalCarAdaptationCoach" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hyundai_accent</item>
        <item name="colorPrimaryVariant">@color/hyundai_blue</item>
        <item name="colorOnPrimary">@color/car_text_primary</item>
        <item name="android:windowBackground">@color/car_bg_dark</item>
        <item name="android:textColorPrimary">@color/car_text_primary</item>
        <item name="android:textColorSecondary">@color/car_text_secondary</item>
    </style>

    <!-- Startup Dialog Theme: Quick floating/modal style or clean fullscreen overlay -->
    <style name="Theme.RentalCarAdaptationCoach.StartupDialog" parent="Theme.RentalCarAdaptationCoach">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/car_bg_dark</item>
    </style>
</resources>

