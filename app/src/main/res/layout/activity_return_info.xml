<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/car_bg_light"
    android:orientation="vertical"
    android:padding="48dp">

    <!-- Top Header / Title (Identical to StartupCarSelectActivity) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_return_info"
            android:textColor="@color/car_text_primary"
            android:textSize="60sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/subtitle_return_info"
            android:textColor="@color/car_text_secondary"
            android:textSize="34sp" />
    </LinearLayout>

    <!-- Two-Column Input Area: Left = Return Location, Right = Return Date & Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="36dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Left Card: 반납지 입력 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:layout_weight="1"
            android:minHeight="450dp"
            app:cardBackgroundColor="@color/car_surface_light"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/car_surface_light_stroke"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="36dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍  반납지"
                    android:textColor="@color/car_text_primary"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etReturnLocation"
                    android:layout_width="match_parent"
                    android:layout_height="112dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_chip_button"
                    android:hint="@string/hint_return_location"
                    android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="28dp"
                    android:textColor="@color/car_text_primary"
                    android:textColorHint="@color/car_text_dim"
                    android:textSize="36sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="자주 찾는 반납지"
                    android:textColor="@color/car_text_secondary"
                    android:textSize="28sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipLocGimpo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_chip_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="16dp"
                        android:text="김포공항"
                        android:textColor="@color/car_text_primary"
                        android:textSize="27sp" />

                    <TextView
                        android:id="@+id/chipLocIncheon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_chip_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="16dp"
                        android:text="인천공항"
                        android:textColor="@color/car_text_primary"
                        android:textSize="27sp" />

                    <TextView
                        android:id="@+id/chipLocSeoulStation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_chip_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="16dp"
                        android:text="서울역"
                        android:textColor="@color/car_text_primary"
                        android:textSize="27sp" />

                    <TextView
                        android:id="@+id/chipLocJeju"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="16dp"
                        android:text="제주공항"
                        android:textColor="@color/car_text_primary"
                        android:textSize="27sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Right Card: 반납 날짜 및 시간 선택 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:layout_weight="1"
            android:minHeight="450dp"
            app:cardBackgroundColor="@color/car_surface_light"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/car_surface_light_stroke"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="36dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗓️  반납 일시"
                    android:textColor="@color/car_text_primary"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <!-- Date Picker Trigger -->
                <LinearLayout
                    android:id="@+id/btnSelectDate"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_chip_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="28dp">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_return_date"
                        android:textColor="@color/car_text_secondary"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/tvSelectedDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2026년 11월 14일 (토)"
                        android:textColor="@color/car_text_primary"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="변경 ›"
                        android:textColor="@color/hyundai_accent"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Time Picker Trigger -->
                <LinearLayout
                    android:id="@+id/btnSelectTime"
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_chip_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="28dp">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="@string/label_return_time"
                        android:textColor="@color/car_text_secondary"
                        android:textSize="30sp" />

                    <TextView
                        android:id="@+id/tvSelectedTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="오후 06:00"
                        android:textColor="@color/car_text_primary"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="변경 ›"
                        android:textColor="@color/hyundai_accent"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Quick Time Chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipTimePlus2h"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_chip_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="16dp"
                        android:text="2시간 후"
                        android:textColor="@color/car_text_primary"
                        android:textSize="27sp" />

                    <TextView
                        android:id="@+id/chipTimeToday18"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_chip_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="16dp"
                        android:text="오늘 18:00"
                        android:textColor="@color/car_text_primary"
                        android:textSize="27sp" />

                    <TextView
                        android:id="@+id/chipTimeTomorrow10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_chip_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="16dp"
                        android:text="내일 10:00"
                        android:textColor="@color/car_text_primary"
                        android:textSize="27sp" />

                    <TextView
                        android:id="@+id/chipTimeTomorrow18"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_chip_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="16dp"
                        android:text="내일 18:00"
                        android:textColor="@color/car_text_primary"
                        android:textSize="27sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Bottom Actions (Identical Style to StartupCarSelectActivity) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBack"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="116dp"
            android:paddingHorizontal="40dp"
            android:text="@string/btn_back_return"
            android:textColor="@color/car_text_secondary"
            android:textSize="36sp" />

        <Button
            android:id="@+id/btnSkip"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="116dp"
            android:paddingHorizontal="40dp"
            android:text="@string/btn_skip_car"
            android:textColor="@color/car_text_secondary"
            android:textSize="36sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="wrap_content"
            android:layout_height="116dp"
            android:alpha="0.45"
            android:backgroundTint="@color/hyundai_accent"
            android:enabled="false"
            android:paddingHorizontal="72dp"
            android:text="@string/btn_confirm_return"
            android:textColor="@color/car_text_on_accent"
            android:textSize="40sp"
            android:textStyle="bold"
            app:cornerRadius="24dp" />
    </LinearLayout>

</LinearLayout>
