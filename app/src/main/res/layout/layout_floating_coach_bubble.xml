<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="end|center_vertical"
    android:orientation="horizontal">

    <!-- Expanded Quick Action Menu (Opens when tapping the floating bubble) -->
    <LinearLayout
        android:id="@+id/bubbleMenuPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="#E6181F2B"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnQuickDefog"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:text="성에 제거"
            android:textColor="@color/car_text_primary"
            android:textSize="13sp"
            app:cornerRadius="8dp"
            app:strokeColor="#3A485E" />

        <Button
            android:id="@+id/btnQuickCruise"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:text="스마트 크루즈"
            android:textColor="@color/car_text_primary"
            android:textSize="13sp"
            app:cornerRadius="8dp"
            app:strokeColor="#3A485E" />

        <Button
            android:id="@+id/btnQuickGear"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:text="기어 조작법"
            android:textColor="@color/car_text_primary"
            android:textSize="13sp"
            app:cornerRadius="8dp"
            app:strokeColor="#3A485E" />

        <Button
            android:id="@+id/btnQuickBriefing"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="체급 브리핑"
            android:textColor="@color/hyundai_active_blue"
            android:textSize="13sp"
            app:cornerRadius="8dp"
            app:strokeColor="@color/hyundai_active_blue" />
    </LinearLayout>

    <!-- The Floating Icon Bubble (Always visible over the real navigation) -->
    <FrameLayout
        android:id="@+id/bubbleIconContainer"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_floating_bubble"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/tvBubbleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="투싼"
                android:textColor="@color/car_text_primary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>

